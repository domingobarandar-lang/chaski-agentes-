# ─── Anthropic (Claude) ─────────────────────────────────────────────────────────
# Obligatoria para producción. En modo demo (MOCK=true / npm run telegram:mock)
# no se necesita ninguna API key. Crear la key en https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ─── LLM multi-proveedor (opcional — default: Anthropic) ─────────────────────
# Para demos a costo $0: LLM_PROVIDER=gemini + LLM_API_KEY (free tier de
# Google AI Studio) + LLM_MODEL=gemini-2.0-flash.
# Proveedores: anthropic | groq | deepseek | gemini | openrouter | ollama |
# openai-compat (este último requiere LLM_BASE_URL).
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# ─── Modo mock ────────────────────────────────────────────────────────────────
# true: fuerza respuestas simuladas en telegram/bot.js y scripts/test-chat.js,
# sin llamar nunca a Anthropic (ni gastar créditos). false/vacío: usa el
# modelo real si hay ANTHROPIC_API_KEY (si no hay key, cae a mock igual).
MOCK=false

# ─── Supabase (COMPARTIDO con agente-citas) ────────────────────────────────────
# Si se dejan vacías, el agente usa una base EN MEMORIA con productos de ejemplo
# (los pedidos no sobreviven a un reinicio — suficiente para la demo).
# Ambos agentes son demos y usan el MISMO proyecto Supabase: mismo SUPABASE_URL
# y misma clave en el .env de agente-citas y de agente-retail.
# Correr schema-compartido.sql (raíz del repo) una sola vez en ese proyecto —
# crea las tablas de los dos agentes con RLS ACTIVADO y sin políticas.
# Por eso la clave es la service_role (Supabase → Project Settings → API), que
# salta RLS: vive SOLO aquí, en el servidor. Nunca en un frontend ni en git.
# La clave anon ya no sirve con RLS activado, y es lo que se quiere: la anon
# es pública por diseño, y con RLS apagado cualquiera que la tenga leería
# los datos de los clientes.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── WhatsApp Cloud API (Meta) ────────────────────────────────────────────────
# Si WHATSAPP_TOKEN está vacío, el sender imprime los mensajes por consola
# (modo demo, sin integración real con Meta).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=un-token-que-tu-inventes
WHATSAPP_APP_SECRET=

# ─── Telegram (gratis — alternativa a WhatsApp para demos) ────────────────────
# Token del bot: crearlo con @BotFather en Telegram (/newbot) y pegarlo aquí.
# NO reutilizar el token de agente-citas (dos bots no pueden compartir token).
# Si está vacío, `npm run telegram` arranca en modo MOCK (simula conversaciones
# por consola, sin Telegram real ni API de Anthropic).
# NOTA: en deploy unificado (Railway, un solo proceso con index.js en la raíz),
# este bot usa TELEGRAM_TOKEN_RETAIL en vez de TELEGRAM_BOT_TOKEN.
TELEGRAM_TOKEN_RETAIL=

# Chat de Telegram del DUEÑO del negocio para avisos automáticos (pedido
# nuevo, cancelación, pendiente anotado). Obtener el id escribiéndole a
# @userinfobot. Vacío = los avisos quedan solo en los logs.
TELEGRAM_CHAT_DUENO=

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3400

# Tope de mensajes por conversación y por día (protege el crédito de la API
# del modelo: el bot es público). Al pasarlo, el bot responde un aviso fijo
# sin llamar al modelo hasta el día siguiente.
LIMITE_MENSAJES_DIA=150
